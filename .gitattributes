# Enforce LF line endings across the entire repository
* text=auto eol=lf

# Explicitly LF for source files
*.py    text eol=lf
*.html  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.env   text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.ico   binary
*.pyc   binary
*.xlsx  binary
